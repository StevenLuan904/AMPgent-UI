{
  "name": "ampgent-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:observer": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:control-plane": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 -FullControlPlane",
    "dev:ui": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "install:start-menu": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/install-start-menu.ps1",
    "uninstall:start-menu": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-start-menu.ps1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:analysis": "vitest run src/analysis"
  },
  "dependencies": {
    "@xyflow/react": "12.11.3",
    "echarts": "6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "1.33.0",
    "molstar": "5.11.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-grid-layout": "1.5.4"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-grid-layout": "^1.3.6",
    "@vitejs/plugin-react": "6.0.5",
    "sass": "1.92.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "^3.2.6"
  }
}
